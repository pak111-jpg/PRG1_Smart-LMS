<Window x:Class="SchulApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SchulApp.Controls"
        Title="SchulApp – Dokumente und Fristen"
        Height="860" Width="1340" MinHeight="720" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        Background="#FFFBFCFF"
        Loaded="Window_Loaded">

    <!-- ===== Hintergrund im kSuite-Look: heller Verlauf mit Pink- und Blauschimmer ===== -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFFDFDFF" Offset="0"/>
                <GradientStop Color="#FFF2F3FC" Offset="0.5"/>
                <GradientStop Color="#FFFCF1F5" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Ellipse Width="900" Height="700" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-260,0,0,-220" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#40F0A8C8" Offset="0"/>
                    <GradientStop Color="#00F0A8C8" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Ellipse Width="820" Height="620" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-200,-200,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#38A9B6F5" Offset="0"/>
                    <GradientStop Color="#00A9B6F5" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===================== Kopfleiste ===================== -->
            <StackPanel Grid.Row="0">

                <!-- ===================== Menü (K0-Z, Aufgabe A2) ===================== -->
                <Menu Background="White" FontSize="12.5" Padding="20,3,20,2">
                    <MenuItem Header="_Datei">
                        <MenuItem Header="_Aktualisieren" Click="MnuAktualisieren_Click"/>
                        <Separator/>
                        <MenuItem Header="_Beenden" Click="MnuBeenden_Click"/>
                    </MenuItem>
                    <MenuItem Header="_Fach">
                        <MenuItem Header="_Neues Fach" Click="MnuNeuesFach_Click"/>
                        <MenuItem Header="Fach _löschen" Click="BtnFachLoeschen_Click"/>
                    </MenuItem>
                    <MenuItem Header="D_okument">
                        <MenuItem Header="_Neues Dokument" Click="MnuNeuesDokument_Click"/>
                        <MenuItem Header="_Alle Dokumente…" Click="MnuAlleDokumente_Click"/>
                    </MenuItem>
                    <MenuItem Header="_Auswertung">
                        <MenuItem Header="_Abgabestand pro Fach…" Click="MnuAuswertung_Click"/>
                    </MenuItem>
                    <MenuItem Header="_Hilfe">
                        <MenuItem Header="_Über SchulApp" Click="MnuUeber_Click"/>
                    </MenuItem>
                </Menu>

            <Border Background="White" BorderBrush="{StaticResource Linie}" BorderThickness="0,0,0,1">
                <Grid Height="64" Margin="28,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SchulApp" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource Pink}"/>
                        <TextBlock Text="Dokumente &amp; Fristen" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextStark}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border x:Name="BdrUeberfaellig" CornerRadius="13" Height="26" Padding="12,0"
                                Background="{StaticResource RotLeise}" VerticalAlignment="Center"
                                Visibility="Collapsed">
                            <TextBlock x:Name="TxtUeberfaellig" VerticalAlignment="Center"
                                       FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource Rot}"/>
                        </Border>
                        <TextBlock x:Name="TxtHeute" Style="{StaticResource Nebentext}" Margin="16,0,16,0"/>
                        <Grid Width="36" Height="36">
                            <Ellipse>
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF16A97A" Offset="0"/>
                                        <GradientStop Color="#FF13BF88" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="SA" Foreground="White" FontSize="12.5" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            </StackPanel>

            <!-- ===================== Inhalt ===================== -->
            <Grid Grid.Row="1" Margin="28,24,28,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="370"/>
                </Grid.ColumnDefinitions>

                <!-- ===== Spalte 1: Fächer ===== -->
                <Border Grid.Column="0" Style="{StaticResource Karte}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource Akzent}"
                                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="Fächer" Style="{StaticResource Kartentitel}"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtFachAnzahl" Style="{StaticResource Nebentext}"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ListBox x:Name="LstFaecher"
                                     Background="Transparent" BorderThickness="0"
                                     ItemContainerStyle="{StaticResource FachItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectionChanged="LstFaecher_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0" Width="34" Height="34" Margin="0,0,11,0">
                                                <Ellipse Fill="{StaticResource AkzentLeise}"/>
                                                <TextBlock Text="{Binding Initialen}" FontSize="11.5"
                                                           FontWeight="SemiBold" Foreground="{StaticResource Akzent}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13.5"
                                                           FontWeight="SemiBold" Foreground="#FF1E2432"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="11.5" Foreground="#FF8A90A2"
                                                           TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding LehrpersonAnzeige, Mode=OneWay}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding DokumenteAnzeige, Mode=OneWay}"/><Run Text="{Binding OffenAnzeige, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock x:Name="TxtKeineFaecher"
                                       Text="Noch keine Fächer. Lege unten dein erstes Fach an."
                                       Style="{StaticResource Nebentext}" TextWrapping="Wrap"
                                       TextAlignment="Center" Margin="20"
                                       VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>

                        <StackPanel Grid.Row="2" Margin="0,14,0,0">
                            <Border Height="1" Background="{StaticResource Linie}" Margin="0,0,0,14"/>

                            <TextBlock Text="FACH" Style="{StaticResource Feldtitel}"/>
                            <TextBox x:Name="TxtNeuesFach" Style="{StaticResource Feld}"
                                     KeyDown="TxtNeuesFach_KeyDown"/>

                            <TextBlock Text="LEHRPERSON (OPTIONAL)" Style="{StaticResource Feldtitel}" Margin="2,12,0,5"/>
                            <TextBox x:Name="TxtNeueLehrperson" Style="{StaticResource Feld}"
                                     KeyDown="TxtNeuesFach_KeyDown"/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnFachHinzufuegen" Grid.Column="0" Content="Fach anlegen"
                                        Style="{StaticResource ButtonPrimaer}" Click="BtnFachHinzufuegen_Click"/>
                                <Button x:Name="BtnFachLoeschen" Grid.Column="2" Content="Löschen"
                                        Style="{StaticResource ButtonLeise}" Click="BtnFachLoeschen_Click"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== Spalte 2: Dokumente ===== -->
                <Border Grid.Column="2" Style="{StaticResource Karte}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Dokumente" Style="{StaticResource Kartentitel}"/>
                                <TextBlock x:Name="TxtFachUntertitel" Style="{StaticResource Nebentext}"
                                           Text="Kein Fach ausgewählt" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock x:Name="TxtDokumentAnzahl" Style="{StaticResource Nebentext}"
                                           HorizontalAlignment="Right"/>
                                <!-- Abgabe-Fortschritt des gewählten Fachs: abgegebene / alle Dokumente -->
                                <ProgressBar x:Name="PrgAbgabe" Width="170" Height="6" Margin="0,6,0,0"
                                             Minimum="0" Maximum="1" Value="0"
                                             BorderThickness="0"
                                             Background="{StaticResource Linie}"
                                             Foreground="{StaticResource Gruen}"
                                             Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <DataGrid x:Name="GrdDokumente"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="None"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      RowHeight="46"
                                      CanUserAddRows="False"
                                      CanUserResizeRows="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      ColumnHeaderStyle="{StaticResource Spaltenkopf}"
                                      CellStyle="{StaticResource Zelle}"
                                      RowStyle="{StaticResource Zeile}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <DataGrid.Columns>

                                    <DataGridTemplateColumn Header="" Width="38">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StatusZeichen}" FontSize="15"
                                                           FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="TITEL" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Titel}" FontWeight="SemiBold"
                                                               FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding DateiAnzeige}" FontSize="11"
                                                               Foreground="#FF9AA0B0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="TYP" Width="120" Binding="{Binding Typ}"/>

                                    <DataGridTemplateColumn Header="FRIST" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FristAnzeige}" FontSize="13"/>
                                                    <TextBlock Text="{Binding RestText}" FontSize="11"
                                                               Foreground="#FF9AA0B0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="STATUS" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StatusText}" FontSize="12.5"
                                                           FontWeight="SemiBold"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="AKTION" Width="200">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Click="BtnAbgabeUmschalten_Click" Margin="0,0,6,0">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource ButtonMini}">
                                                                <Setter Property="Content" Value="Abgeben"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Abgegeben}" Value="True">
                                                                        <Setter Property="Content" Value="Zurücknehmen"/>
                                                                        <Setter Property="Foreground" Value="#FF16A97A"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Content="Löschen" Style="{StaticResource ButtonMini}"
                                                            Foreground="#FF9AA0B0"
                                                            Click="BtnDokumentLoeschen_Click"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock x:Name="TxtKeineDokumente"
                                       Text="Für dieses Fach ist noch nichts abgelegt."
                                       Style="{StaticResource Nebentext}"
                                       TextAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>

                        <!-- Erfassungsformular als UserControl (K0-Z, Aufgabe A3) -->
                        <controls:DokumentEingabe x:Name="Eingabemaske" Grid.Row="2" Margin="0,14,0,0"
                                                  Ablegen="Eingabemaske_Ablegen"/>
                    </Grid>
                </Border>

                <!-- ===== Spalte 3: Fristen ===== -->
                <Border Grid.Column="4" Style="{StaticResource Karte}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource Pink}"
                                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <StackPanel>
                                    <TextBlock Text="Offene Fristen" Style="{StaticResource Kartentitel}"/>
                                    <TextBlock Text="Alle Fächer, nach Datum" Style="{StaticResource Nebentext}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="TxtFristenAnzahl" Style="{StaticResource Nebentext}"
                                       HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="LstFristen">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Eintrag" Background="{StaticResource Fuellung}"
                                                    CornerRadius="11" Margin="0,0,0,8" Padding="0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="4"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border x:Name="Balken" Grid.Column="0"
                                                            Background="#FF5B5BD6" CornerRadius="2"
                                                            Margin="0,8"/>

                                                    <StackPanel Grid.Column="1" Margin="12,10,8,10">
                                                        <TextBlock x:Name="TitelText" Text="{Binding Titel}"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="#FF1E2432"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock FontSize="11.5" Foreground="#FF8A90A2"
                                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                                                            <Run Text="{Binding FachName, Mode=OneWay}"/>
                                                            <Run Text=" · "/>
                                                            <Run Text="{Binding Typ, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <TextBlock x:Name="FristText" FontSize="11.5"
                                                                   FontWeight="SemiBold" Foreground="#FF5B5BD6"
                                                                   Margin="0,3,0,0">
                                                            <Run Text="{Binding FristAnzeige, Mode=OneWay}"/>
                                                            <Run Text=" · "/>
                                                            <Run Text="{Binding RestText, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <Button Grid.Column="2" Content="Abgeben"
                                                            Style="{StaticResource ButtonMini}"
                                                            VerticalAlignment="Center" Margin="0,0,10,0"
                                                            Click="BtnFristAbgeben_Click"/>
                                                </Grid>
                                            </Border>

                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IstUeberfaellig}" Value="True">
                                                    <Setter TargetName="Eintrag" Property="Background" Value="#FFFDF2F4"/>
                                                    <Setter TargetName="Balken" Property="Background" Value="#FFD6304B"/>
                                                    <Setter TargetName="TitelText" Property="Foreground" Value="#FFD6304B"/>
                                                    <Setter TargetName="FristText" Property="Foreground" Value="#FFD6304B"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock x:Name="TxtKeineFristen"
                                       Text="Keine offenen Fristen. Alles abgegeben."
                                       Style="{StaticResource Nebentext}"
                                       TextAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===================== Statuszeile ===================== -->
            <TextBlock x:Name="TxtStatus" Grid.Row="2" Margin="30,0,30,14"
                       FontSize="11.5" Foreground="{StaticResource TextLeise}"/>
        </Grid>
    </Grid>
</Window>
