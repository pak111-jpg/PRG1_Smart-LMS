<Window x:Class="SchulApp.AuswertungWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SchulApp – Abgabe-Auswertung"
        Height="520" Width="760" MinHeight="360" MinWidth="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        Background="#FFF7F8FC"
        Loaded="Window_Loaded">

    <Border Style="{StaticResource Karte}" Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Abgabe-Auswertung" Style="{StaticResource Kartentitel}"/>
                <TextBlock Text="Abgabestand pro Fach" Style="{StaticResource Nebentext}" Margin="0,2,0,0"/>
            </StackPanel>

            <DataGrid x:Name="GrdAuswertung" Grid.Row="1"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource Linie}"
                      Background="Transparent"
                      RowBackground="Transparent"
                      BorderThickness="0"
                      RowHeight="40"
                      FontSize="13"
                      Foreground="{StaticResource TextStark}"
                      CanUserAddRows="False"
                      CanUserResizeRows="False"
                      SelectionMode="Single"
                      ColumnHeaderStyle="{StaticResource Spaltenkopf}">
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="8,0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="FACH" Width="*" Binding="{Binding FachName}"/>
                    <DataGridTextColumn Header="DOKUMENTE" Width="95" Binding="{Binding Gesamt}"/>
                    <DataGridTextColumn Header="ABGEGEBEN" Width="95" Binding="{Binding Abgegeben}"/>
                    <DataGridTextColumn Header="OFFEN" Width="70" Binding="{Binding Offen}"/>
                    <DataGridTextColumn Header="ÜBERFÄLLIG" Width="95" Binding="{Binding Ueberfaellig}"/>
                    <DataGridTemplateColumn Header="FORTSCHRITT" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ProgressBar Width="90" Height="6" Minimum="0" Maximum="100"
                                                 Value="{Binding ProzentAbgegeben, Mode=OneWay}"
                                                 BorderThickness="0"
                                                 Background="{StaticResource Linie}"
                                                 Foreground="{StaticResource Gruen}"/>
                                    <TextBlock Text="{Binding ProzentAnzeige}" Margin="10,0,0,0"
                                               FontSize="12" Foreground="{StaticResource TextLeise}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="2" Margin="0,14,0,0">
                <TextBlock x:Name="TxtGesamt" Style="{StaticResource Nebentext}"
                           FontWeight="SemiBold" Foreground="{StaticResource TextStark}"/>
                <Button Content="Schliessen" Style="{StaticResource ButtonLeise}"
                        HorizontalAlignment="Right" IsCancel="True" IsDefault="True"
                        Click="BtnSchliessen_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
