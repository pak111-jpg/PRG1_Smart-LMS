<Window x:Class="SchulApp.AlleDokumenteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SchulApp – Alle Dokumente"
        Height="620" Width="900" MinHeight="420" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        Background="#FFF7F8FC"
        Loaded="Window_Loaded">

    <Border Style="{StaticResource Karte}" Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Alle Dokumente" Style="{StaticResource Kartentitel}"/>
                <TextBlock Text="Über alle Fächer, mit Suche, Filter und Sortierung"
                           Style="{StaticResource Nebentext}" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Suche, Filter und Sortierung: Jede Änderung löst eine neue LINQ-Abfrage aus -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="SUCHE IM TITEL" Style="{StaticResource Feldtitel}"/>
                    <TextBox x:Name="TxtSuche" Style="{StaticResource Feld}"
                             TextChanged="TxtSuche_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="STATUS" Style="{StaticResource Feldtitel}"/>
                    <Border Style="{StaticResource FeldHuelle}">
                        <ComboBox x:Name="CmbFilter" BorderThickness="0" Background="Transparent"
                                  FontSize="13" VerticalContentAlignment="Center"
                                  SelectedIndex="0" SelectionChanged="Auswahl_SelectionChanged">
                            <ComboBoxItem Content="Alle"/>
                            <ComboBoxItem Content="Offen"/>
                            <ComboBoxItem Content="Abgegeben"/>
                            <ComboBoxItem Content="Überfällig"/>
                        </ComboBox>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="SORTIERUNG" Style="{StaticResource Feldtitel}"/>
                    <Border Style="{StaticResource FeldHuelle}">
                        <ComboBox x:Name="CmbSortierung" BorderThickness="0" Background="Transparent"
                                  FontSize="13" VerticalContentAlignment="Center"
                                  SelectedIndex="0" SelectionChanged="Auswahl_SelectionChanged">
                            <ComboBoxItem Content="Nach Frist"/>
                            <ComboBoxItem Content="Nach Titel"/>
                            <ComboBoxItem Content="Nach Fach"/>
                        </ComboBox>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <DataGrid x:Name="GrdAlleDokumente"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          Background="Transparent"
                          BorderThickness="0"
                          RowHeight="40"
                          CanUserAddRows="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          ColumnHeaderStyle="{StaticResource Spaltenkopf}"
                          CellStyle="{StaticResource Zelle}"
                          RowStyle="{StaticResource Zeile}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="" Width="38" Binding="{Binding StatusZeichen}"/>
                        <DataGridTextColumn Header="TITEL" Width="*" Binding="{Binding Titel}"/>
                        <DataGridTextColumn Header="FACH" Width="140" Binding="{Binding FachName}"/>
                        <DataGridTextColumn Header="TYP" Width="100" Binding="{Binding Typ}"/>
                        <DataGridTextColumn Header="FRIST" Width="100" Binding="{Binding FristAnzeige}"/>
                        <DataGridTextColumn Header="RESTZEIT" Width="140" Binding="{Binding RestText}"/>
                        <DataGridTextColumn Header="STATUS" Width="100" Binding="{Binding StatusText}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="TxtKeineTreffer" Text="Keine Dokumente gefunden."
                           Style="{StaticResource Nebentext}"
                           TextAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>

            <Grid Grid.Row="3" Margin="0,14,0,0">
                <TextBlock x:Name="TxtAnzahl" Style="{StaticResource Nebentext}"/>
                <Button Content="Schliessen" Style="{StaticResource ButtonLeise}"
                        HorizontalAlignment="Right" IsCancel="True"
                        Click="BtnSchliessen_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
